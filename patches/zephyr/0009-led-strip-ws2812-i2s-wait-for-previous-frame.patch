+/*
+ * Allocate a TX block for a new frame.
+ *
+ * The slab holds two blocks, which is the minimum the I2S API requires for a
+ * queue, and the driver releases a block only once it has been transmitted (or
+ * dropped). Taking both blocks and returning the second one immediately
+ * therefore waits for the previous frame to complete; relying on the transfer
+ * time alone leaves a window in which the next frame is queued while the
+ * previous one is still being drained.
+ */
+static int ws2812_i2s_acquire_tx_buffer(const struct ws2812_i2s_cfg *cfg, void **mem_block)
+{
+	void *barrier_block;
+	int ret;
+
+	*mem_block = NULL;
+
+	ret = k_mem_slab_alloc(cfg->mem_slab, mem_block, K_SECONDS(10));
+	if (ret < 0) {
+		LOG_ERR("Unable to allocate mem slab for TX (err %d)", ret);
+		return -ENOMEM;
+	}
+
+	ret = k_mem_slab_alloc(cfg->mem_slab, &barrier_block, K_SECONDS(1));
+	if (ret < 0) {
+		k_mem_slab_free(cfg->mem_slab, *mem_block);
+		*mem_block = NULL;
+		LOG_ERR("Previous LED strip frame did not complete (err %d)", ret);
+		return -EBUSY;
+	}
+
+	k_mem_slab_free(cfg->mem_slab, barrier_block);
+
+	return 0;
+}
