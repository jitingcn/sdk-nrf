+{
+	struct ws2812_i2s_data *data = dev->data;
+	int ret;
+
+	k_mutex_lock(&data->lock, K_FOREVER);
+	ret = ws2812_i2s_update_channels(dev, channels, num_channels);
+	k_mutex_unlock(&data->lock);
+
+	return ret;
+}
